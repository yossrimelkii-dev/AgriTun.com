# Caddy production config for TunAgri.
# {$DOMAIN} and {$ACME_EMAIL} are read from environment (see docker-compose.prod.yml).

{
    email {$ACME_EMAIL}
    # Comment out the next line once you've verified staging works, to switch to
    # Let's Encrypt production. (Staging avoids getting rate-limited during testing.)
    # acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
    servers {
        protocols h1 h2 h3
    }
}

{$DOMAIN}, www.{$DOMAIN} {
    encode zstd gzip

    # Redirect www → apex (SEO best practice — single canonical host).
    @www host www.{$DOMAIN}
    redir @www https://{$DOMAIN}{uri} permanent

    # Security headers (Next also sets some via next.config.mjs — these are the
    # HTTP-level headers Caddy adds regardless of upstream behaviour).
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "DENY"
        Referrer-Policy           "strict-origin-when-cross-origin"
        Permissions-Policy        "camera=(), microphone=(), geolocation=(self)"
        # Hide the server banner.
        -Server
    }

    # Long-cache Next.js hashed static assets.
    @next_static path /_next/static/*
    header @next_static Cache-Control "public, max-age=31536000, immutable"

    # Long-cache the /public folder assets Next fingerprints.
    @public_static path /favicon.ico /robots.txt /sitemap.xml /agritun.png
    header @public_static Cache-Control "public, max-age=86400"

    reverse_proxy web:3000 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
