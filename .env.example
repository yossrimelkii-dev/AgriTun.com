# MongoDB
MONGODB_URI=mongodb://admin:password@localhost:27017/tunagri?authSource=admin&retryWrites=true

# Auth
NEXTAUTH_SECRET=change-me-to-a-32-char-secret-value
NEXTAUTH_URL=http://localhost:3000

# Redis (Upstash or local)
REDIS_URL=redis://localhost:6379

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=local-dev-master-key

# Storage (Cloudflare R2 or AWS S3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tunagri-uploads
R2_PUBLIC_URL=https://cdn.tunagri.com

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password

# Payments
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# Monitoring
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=

# Maps (Google Maps JavaScript API)
# Free-trial mode: Google offers monthly free credits, but billing setup is still required.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Twilio SMS
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+10000000000
SMS_ENABLED=true
SMS_2FA_ENABLED=false
DEFAULT_COUNTRY_CODE=216
