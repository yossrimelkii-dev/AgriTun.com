# ============================================================
# TunAgri — Production environment template
# Copy this file to `.env.production` on the VPS and fill values.
# NEVER commit `.env.production` to git.
# ============================================================

# ── Domain / TLS (used by Caddy) ─────────────────────────────
DOMAIN=tunagri.com
# Address Let's Encrypt uses to warn you about cert issues.
ACME_EMAIL=admin@tunagri.com

# ── App ──────────────────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://tunagri.com

# ── MongoDB (local Docker service, NOT Atlas) ────────────────
# These two are read by BOTH the mongodb container (init) and the migration/
# backup scripts. Keep them strong and secret.
#   Generate with:  openssl rand -hex 24
MONGO_ROOT_USER=tunagri_admin
MONGO_ROOT_PASSWORD=CHANGE-ME-openssl-rand-hex-24

# Connection string the Next.js app uses. Hostname `mongodb` is the
# container name on the internal Docker network — do not change it.
# Note: `authSource=admin` is required because the user is created in `admin`.
MONGODB_URI=mongodb://tunagri_admin:CHANGE-ME-SAME-PASSWORD-AS-ABOVE@mongodb:27017/tunagri?authSource=admin

# ── Auth / JWT ───────────────────────────────────────────────
#   Generate with:  openssl rand -base64 48
NEXTAUTH_SECRET=CHANGE-ME-openssl-rand-base64-48
NEXTAUTH_URL=https://tunagri.com

# ── Cloudinary (image uploads: product images, invoice logos) ─
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── One-time: your Atlas connection string (for migration only) ─
# Only needed the first time to run scripts/migrate-from-atlas.sh.
# Delete or leave blank after migration.
ATLAS_URI=

# ── Optional: Redis (only if you use it) ─────────────────────
# REDIS_URL=redis://redis:6379

# ── Optional: Meilisearch (only if you use search) ───────────
# MEILISEARCH_HOST=http://meilisearch:7700
# MEILISEARCH_KEY=

# ── Optional: R2 / S3 storage ────────────────────────────────
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=

# ── Optional: SMTP (transactional email) ─────────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ── Optional: Stripe (payments) ──────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── Optional: Twilio (SMS / 2FA) ─────────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# SMS_ENABLED=false
# SMS_2FA_ENABLED=false
# DEFAULT_COUNTRY_CODE=216

# ── Optional: Google Maps / analytics ────────────────────────
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_POSTHOG_KEY=
# SENTRY_DSN=
